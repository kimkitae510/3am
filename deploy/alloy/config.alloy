// Grafana Alloy 설정 — 앱 지표와 호스트 지표를 1분 주기로 긁어 Grafana Cloud로 민다.
//
// 설치:
//   sudo cp deploy/alloy/config.alloy /etc/alloy/config.alloy
//   토큰은 /etc/alloy/token (권한 600, 소유 alloy) — 파일 내용이 토큰 문자열 하나다.
//   sudo systemctl restart alloy
//
// 토큰은 Grafana Cloud 포털의 Access Policy(metrics:write 권한)에서 발급한다.
// 설정 파일엔 토큰을 직접 넣지 않는다 — 이 파일은 저장소에 커밋되기 때문이다.

// ── 앱 지표: 스프링 액추에이터 (management 포트, 로컬 전용) ──────────────
prometheus.scrape "app" {
  targets = [{
    __address__ = "127.0.0.1:9090",
    job         = "3am-app",
  }]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.trim.receiver]
}

// ── 호스트 지표: CPU, 메모리, 디스크, 네트워크 (node_exporter 내장판) ────
// 컬렉터를 필요한 것만 켠다 — 기본값 전부를 켜면 시리즈가 수백 개 늘어난다.
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "meminfo", "filesystem", "diskstats", "netdev", "loadavg", "uname"]

  filesystem {
    // 가상/임시 마운트는 디스크 경보에 의미가 없다.
    fs_types_exclude = "^(tmpfs|devtmpfs|overlay|squashfs|proc|sysfs|cgroup2?)$"
  }
  netdev {
    // 루프백과 가상 인터페이스 제외.
    device_exclude = "^(lo|veth.*|docker.*)$"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.trim.receiver]
}

// ── 가짓수 절감: 안 보는 지표는 전송 전에 버린다 ─────────────────────────
prometheus.relabel "trim" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // JVM 버퍼풀 세부, 클래스 로딩 수는 대시보드나 경보 어디에도 안 쓴다.
  rule {
    source_labels = ["__name__"]
    regex         = "(jvm_buffer_.*|jvm_classes_.*)"
    action        = "drop"
  }
}

// ── DB 내부 지표: MySQL 원격 수집 (읽기 전용 모니터링 계정) ──────────────
// 접속 문자열(계정:비밀번호@주소)은 서버 파일로만 관리 — 커밋 금지.
// 파일이 없으면 Alloy 기동이 실패하니, 이 설정을 올릴 때 반드시 함께 만든다.
local.file "mysql_dsn" {
  filename  = "/etc/alloy/mysql_dsn"
  is_secret = true
}

prometheus.exporter.mysql "db" {
  data_source_name = local.file.mysql_dsn.content
}

prometheus.scrape "db" {
  targets         = prometheus.exporter.mysql.db.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.trim.receiver]
}

// ── 로그: WARN/ERROR 덩어리만 로키로 ────────────────────────────────────
// INFO 전문은 서버 파일에만 남긴다 — 사연(개인정보)이 스밀 수 있는 건 주로 INFO 쪽이라
// 노출면을 좁히는 결정. 에러 원인 조회의 99%는 WARN/ERROR면 충분하다.
local.file_match "app_logs" {
  path_targets = [{ __path__ = "/opt/3am/logs/3am.log", job = "3am-app-logs" }]
}

loki.source.file "app" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.warn_error.receiver]
}

loki.process "warn_error" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // 스택트레이스(레벨 표기 없는 후속 줄)가 에러 본줄과 한 덩어리로 묶이게 먼저 합친다.
  stage.multiline {
    firstline = "^\\d{4}-\\d{2}-\\d{2} "
  }
  // INFO/DEBUG/TRACE 덩어리는 전송 전에 버린다.
  stage.drop {
    expression = "\\] (INFO|DEBUG|TRACE) "
  }
  stage.static_labels {
    values = { app = "3am" }
  }
}

// ── Grafana Cloud로 전송 (도쿄 리전 스택: pinksquid1124) ─────────────────
// 토큰 하나로 지표와 로그 둘 다 민다 — 정책(alloy-write)에 metrics:write + logs:write.
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-49-prod-ap-northeast-0.grafana.net/api/prom/push"

    basic_auth {
      username      = "3423402"            // 스택의 Prometheus 인스턴스 ID
      password_file = "/etc/alloy/token"   // 커밋 금지, 서버에만
    }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-030.grafana.net/loki/api/v1/push"

    basic_auth {
      username      = "1707376"            // 스택의 Loki 인스턴스 ID
      password_file = "/etc/alloy/token"
    }
  }
}
