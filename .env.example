# 환경변수 템플릿 — 이 파일은 커밋된다(값은 비어 있다).
# 실제 값을 채운 사본은 .env로 두고 커밋하지 않는다(gitignore).
#
# 주입 방법은 실행 환경마다 다르다:
#   로컬(IntelliJ)  실행 구성의 Environment variables에 KEY=VALUE;KEY=VALUE 형태로
#   서버(systemd)   EnvironmentFile=/etc/3am/.env
#   서버(docker)    docker run --env-file .env  또는 compose의 env_file
# Spring Boot는 .env를 자동으로 읽지 않는다 — 위 방법 중 하나로 환경변수가 되어야 적용된다.
#
# 값이 비어 있어도 뜨는 항목은 기본값이 application.yml에 있다. 아래 [필수]만 반드시 채운다.

# ── 데이터베이스 [필수] ────────────────────────────────────────────
# DB를 별도 서버에 두면 HOST를 그 사설 IP로. 비우면 localhost:3306/threeam.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── 인증 [필수] ───────────────────────────────────────────────────
# 256비트 이상 랜덤. 예: openssl rand -base64 48
JWT_SECRET=

# ── LLM 공통 ─────────────────────────────────────────────────────
# mock=키 불필요한 개발 스텁 / gemini=AI Studio API 키 / vertex=GCP 서비스 계정
LLM_PROVIDER=vertex
LLM_MODEL=gemini-3.1-pro-preview
# 진단 전용 모델. 비우면 LLM_MODEL을 쓴다.
LLM_ASSESSMENT_MODEL=gemini-3.1-pro-preview

# thinking 세기. 2.5 계열은 BUDGET(토큰 숫자), 3.x는 LEVEL(low|medium|high)만 듣는다.
# 실측: 3.x에서 LEVEL은 상한 힌트라 올려도 추론량이 안 늘 수 있다(채팅 1,600~1,900 고정).
LLM_THINKING_LEVEL=low
LLM_THINKING_BUDGET=2048
LLM_ASSESSMENT_THINKING_LEVEL=medium
LLM_ASSESSMENT_THINKING_BUDGET=-1
# 채팅 생성 온도. 미설정이면 API 기본 1.0이라 규칙 이탈이 는다. 진단은 코드에서 0 고정.
LLM_TEMPERATURE=0.7

# 100만 토큰당 단가. 넣으면 호출마다 실비가 로그와 지표로 남는다(단위 무관 — 원화를 넣으면 원화로 찍힌다).
# 값 확인: GCP 빌링 콘솔의 Vertex AI SKU 가격표. 모델을 바꾸면 이 셋도 같이 바꾼다.
LLM_PRICE_INPUT=
LLM_PRICE_CACHED_INPUT=
LLM_PRICE_OUTPUT=

# ── LLM: gemini 경로 (LLM_PROVIDER=gemini일 때) ────────────────────
LLM_API_KEY=

# ── LLM: vertex 경로 (LLM_PROVIDER=vertex일 때) ────────────────────
GCP_PROJECT_ID=
GCP_LOCATION=global
# 서비스 계정 키 JSON의 절대 경로. 반드시 저장소 밖에 둔다.
GOOGLE_APPLICATION_CREDENTIALS=

# ── 사례 데이터 ───────────────────────────────────────────────────
# 서비스 자산이라 저장소와 빌드 산출물에 넣지 않는다. 서버에서는 절대 경로로 준다.
MATCH_CASE_FILE=사례데이터.json

# ── 인증 메일 ────────────────────────────────────────────────────
# mock=발송 없이 서버 로그로 코드 확인 / smtp=실발송
MAIL_PROVIDER=mock
MAIL_USERNAME=
# Gmail 앱 비밀번호(계정 비밀번호가 아니다)
MAIL_PASSWORD=

# ── 소셜 로그인 ──────────────────────────────────────────────────
# mock=키 불필요(같은 code면 같은 계정) / real=실연동
OAUTH_PROVIDER=mock
KAKAO_CLIENT_ID=
# 카카오 콘솔에서 보안 설정을 켰을 때만 필요
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 결제 ─────────────────────────────────────────────────────────
# mock=키 불필요, 무조건 승인 / toss=국내 PG / paddle=해외 MoR / disabled=결제만 닫음
PAYMENT_PROVIDER=mock
# 프론트 위젯용(공개 가능)
TOSS_CLIENT_KEY=
# 서버 승인, 취소용(절대 비공개)
TOSS_SECRET_KEY=

# ── 결제: 패들 (PAYMENT_PROVIDER=paddle일 때) ──────────────────────
# Developer Tools > Authentication에서 발급. client-token은 프론트 결제창용 공개 키
# (백엔드가 /api/payments/config로 내려준다), api-key는 서버 조회/환불용이라 절대 비공개.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# 웹훅 서명 검증 키. Developer Tools > Notifications에서 알림 대상을 만들 때 발급된다.
# 비어 있으면 웹훅을 전부 거부한다(검증 없이 열어두지 않는다).
PADDLE_WEBHOOK_SECRET=
# 샌드박스 https://sandbox-api.paddle.com / 운영 https://api.paddle.com
PADDLE_BASE_URL=https://sandbox-api.paddle.com
# 운영 서버에서 샌드박스로 검증할 때만 true. 켜져 있으면 실결제가 되지 않는다 —
# 오픈 전에 반드시 지우거나 false로 되돌린다(부팅 로그에 경고가 남는다).
PADDLE_ALLOW_SANDBOX_IN_PROD=false
# 패들 대시보드에서 만든 가격의 ID(pri_로 시작). 상품을 바꾸면 이 값만 갈아끼운다.
PADDLE_PRICE_BUNDLE_STANDARD=

# ── CORS ─────────────────────────────────────────────────────────
# 프론트 origin. 콤마로 여러 개. 운영 도메인으로 바꾼다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 진단 공유 ─────────────────────────────────────────────────────
# /s/{token} OG 페이지의 절대 URL(og:url, og:image) 기준 주소. 운영은 https://3amchat.xyz
SHARE_BASE_URL=http://localhost:5173
