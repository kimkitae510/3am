# 프론트 환경변수 템플릿 — 이 파일은 커밋된다(값은 예시나 빈 값이다).
# 실제 값은 .env나 .env.local에 두고 커밋하지 않는다.
# Vite는 VITE_ 접두어가 붙은 것만 번들에 넣는다 — 여기 값은 브라우저에 그대로 노출되니
# 비밀 키(토스 시크릿, 소셜 시크릿)는 절대 넣지 않는다.

# 백엔드 주소. 운영은 https 도메인으로 바꾼다.
VITE_API_BASE_URL=http://localhost:8080

# 소셜 로그인 인가 요청용 공개 키(REST API 키). 비우면 버튼이 개발용 mock 흐름으로 간다.
VITE_KAKAO_CLIENT_ID=
VITE_NAVER_CLIENT_ID=

# 패들 결제창 환경변수는 없다 — 백엔드가 내려주는 client-token의 접두어(test_/live_)로
# 샌드박스/실결제가 자동 판별된다. 서버의 PADDLE_CLIENT_TOKEN만 갈아끼우면 된다.
